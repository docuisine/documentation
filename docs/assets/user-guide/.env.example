# This is an example production environment file for Docuisine application.
# Copy this file to .env and modify the values as needed.

## It is recommended to change the default values host machine compatibility purposes.
DOCUISINE_FRONTEND_PORT=3000 # This is where you can access the web client

## It is recommended to change the default values for security purposes.
POSTGRES_PASSWORD=password
POSTGRES_USER=user
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
JWT_SECRET_KEY=4e9db3a3f86d82cb45f552b9e24e7a652fbb5d3565a3f60a798f904cee6b235b # Replace with random letters and numbers

## You can leave the following values as is, unless you have specific requirements.
DOCUISINE_BACKEND_PORT=7000
MODE=production

JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

POSTGRES_DB=docuisine
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

S3_BUCKET_NAME=docuisine-images
S3_PORT=9000
S3_CONSOLE_PORT=9001